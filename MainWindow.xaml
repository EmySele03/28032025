<Window x:Class="proyecto_progra_s.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Pesas"
        Height="720"
        Width="1100"
        Background="#F8F4EC">

    <Grid>
        <TabControl Margin="10">

            <!-- PARTICIPANTES -->
            <TabItem Header="Participantes">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ID"/>
                        <TextBox x:Name="txtId"
                                 Height="30"
                                 Margin="0,5,0,10"/>

                        <TextBlock Text="Nombre"/>
                        <TextBox x:Name="txtNombre"
                                 Height="30"
                                 Margin="0,5,0,10"/>

                        <TextBlock Text="Sexo"/>
                        <ComboBox x:Name="cbSexo"
                                  Height="30"
                                  Margin="0,5,0,10">
                            <ComboBoxItem Content="Masculino"/>
                            <ComboBoxItem Content="Femenino"/>
                        </ComboBox>

                        <TextBlock Text="Categoria Peso"/>
                        <ComboBox x:Name="cbPeso"
                                  Height="30"
                                  Margin="0,5,0,20">
                            <ComboBoxItem Content="61kg"/>
                            <ComboBoxItem Content="73kg"/>
                            <ComboBoxItem Content="89kg"/>
                            <ComboBoxItem Content="+102kg"/>
                        </ComboBox>

                        <Button Content="Guardar Participante"
                                Height="40"
                                Margin="7"
                                Background="#7DA8BE"
                                Foreground="White"
                                Click="BtnGuardar_Click"/>

                        <Button Content="Editar"
                                Height="40"
                                Margin="7"
                                Background="#7DA8BE"
                                Foreground="White"
                                Click="BtnEditarParticipante_Click"/>

                        <Button Content="Eliminar"
                                Height="40"
                                Margin="7"
                                Background="#FFF1B8"
                                Foreground="Black"
                                Click="BtnEliminarParticipante_Click"/>

                        <Button Content="Buscar"
                                Height="40"
                                Margin="7"
                                Background="#FFF1B8"
                                Foreground="Black"
                                Click="BtnBuscarParticipante_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgParticipantes"
                              Grid.Column="2"
                              AutoGenerateColumns="True"
                              Background="White"
                              MouseDoubleClick="dgParticipantes_MouseDoubleClick"/>
                </Grid>
            </TabItem>

            <!-- PREPARACION -->
            <TabItem Header="Preparacion">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Participante"/>
                        <ComboBox x:Name="cbPreparacionParticipante"
                                  Height="30"
                                  Margin="0,5,0,20"/>

                        <Border Background="#FFF1B8"
                                Padding="10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Arranque"
                                           FontWeight="Bold"/>

                                <TextBox x:Name="txtA1"
                                         Height="30"
                                         Margin="0,5"/>

                                <TextBox x:Name="txtA2"
                                         Height="30"
                                         Margin="0,5"/>

                                <TextBox x:Name="txtA3"
                                         Height="30"
                                         Margin="0,5"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#D6EAF2"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="Envion"
                                           FontWeight="Bold"/>

                                <TextBox x:Name="txtE1"
                                         Height="30"
                                         Margin="0,5"/>

                                <TextBox x:Name="txtE2"
                                         Height="30"
                                         Margin="0,5"/>

                                <TextBox x:Name="txtE3"
                                         Height="30"
                                         Margin="0,5"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Guardar Intentos"
                                Height="40"
                                Margin="7"
                                Background="#7DA8BE"
                                Foreground="White"
                                Click="BtnGuardarIntentos_Click"/>

                        <Button Content="Editar Intentos"
                                Height="40"
                                Margin="7"
                                Background="#7DA8BE"
                                Foreground="White"
                                Click="BtnEditarIntentos_Click"/>

                        <Button Content="Eliminar Intentos"
                                Height="40"
                                Margin="7"
                                Background="#FFF1B8"
                                Click="BtnEliminarIntentos_Click"/>

                        <Button x:Name="btnGuardarLista"
                                Content="Guardar Lista"
                                Height="40"
                                Margin="7"
                                Background="#FFF1B8"
                                Click="BtnGuardarLista_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgIntentos"
                              Grid.Column="2"
                              AutoGenerateColumns="True"
                              Background="White"/>
                </Grid>
            </TabItem>

            <!-- COMPETENCIA -->
            <TabItem Header="Competencia">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Participante"/>
                        <ComboBox x:Name="cbCompetenciaParticipante"
                                  Height="30"
                                  Margin="0,5,0,20"/>

                        <Button Content="Buscar"
                                Height="40"
                                Background="#7DA8BE"
                                Foreground="White"
                                Click="BtnBuscar_Click"/>

                        <TextBlock Text="Nombre"
                                   Margin="0,20,0,0"/>
                        <TextBlock x:Name="lblNombre"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Categoria"
                                   Margin="0,20,0,0"/>
                        <TextBlock x:Name="lblCategoria"
                                   FontSize="18"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Background="#FFF1B8"
                                Padding="10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Arranque"
                                           FontWeight="Bold"
                                           FontSize="18"/>

                                <CheckBox x:Name="chkA1"
                                          Margin="0,10,0,0"/>
                                <CheckBox x:Name="chkA2"
                                          Margin="0,10,0,0"/>
                                <CheckBox x:Name="chkA3"
                                          Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#D6EAF2"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="Envion"
                                           FontWeight="Bold"
                                           FontSize="18"/>

                                <CheckBox x:Name="chkE1"
                                          Margin="0,10,0,0"/>
                                <CheckBox x:Name="chkE2"
                                          Margin="0,10,0,0"/>
                                <CheckBox x:Name="chkE3"
                                          Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Registrar"
                                Height="40"
                                Margin="0,20,0,0"
                                Background="#7DA8BE"
                                Foreground="White"
                                Click="BtnRegistrar_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- RESULTADOS -->
            <TabItem Header="Resultados">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgResultados"
                              Grid.Row="0"
                              AutoGenerateColumns="True"
                              Background="White"
                              Margin="0,0,0,15"/>

                    <Button x:Name="btnGuardarResultados"
                            Grid.Row="1"
                            Content="Guardar Resultados"
                            Width="294"
                            Height="40"
                            HorizontalAlignment="Right"
                            Background="PeachPuff"
                            Foreground="White"
                            Click="BtnGuardarResultados_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
