<?xml version="1.0" encoding="utf-8"?>
<!--
  VERTICAL (portrait)
  Dónde: app/src/main/res/layout/activity_main.xml
  Raíz = ConstraintLayout (id: main)
  Dentro = LinearLayout vertical con los controles
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearContenedor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/title"
            android:textColor="@color/purple_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/subtitle"
            android:textSize="16sp" />

        <!-- Campo 1 (ej. nombre) — sin label obligatorio -->
        <EditText
            android:id="@+id/etCampo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/hint_campo1"
            android:inputType="textPersonName"
            android:minHeight="48dp" />

        <!-- Campo 2 (ej. carrera) -->
        <EditText
            android:id="@+id/etCampo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_campo2"
            android:inputType="text"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnMostrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/purple_primary"
            android:text="@string/btn_mostrar"
            android:textColor="@color/white" />

        <!-- Aquí aparecen los datos al pulsar el botón -->
        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/result_bg"
            android:minHeight="80dp"
            android:padding="16dp"
            android:text="@string/resultado_vacio"
            android:textColor="@color/gray_hint"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
